# Trusted Bash configuration. Copy to client.env and chmod 600.
PQHEAL_API_KEY=replace-me
PQHEAL_SERVER_URL=https://server.example:9000
PQHEAL_KEY_PIN=replace-with-trusted-64-character-fingerprint
# Set for a private CA; otherwise use the operating system trust store.
# SSL_CERT_FILE=/absolute/path/test-ca.crt
PQHEAL_CLIENT_ID=test-heart-01
PQHEAL_SUBJECT_ID=test-subject-01
PQHEAL_SENSOR_TYPE=heart_rate
PQHEAL_FREQUENCY=5s

# Trusted Bash configuration. Copy to server.env and chmod 600.
PQHEAL_API_KEY=replace-me
PQHEAL_BIND=192.0.2.10
PQHEAL_PORT=9000
PQHEAL_TLS_CERT=/absolute/path/server.crt
PQHEAL_TLS_KEY=/absolute/path/server.key
# Optional; defaults resolve inside this package:
# PQHEAL_MODEL=/absolute/path/anomaly-model.json
# PQHEAL_STATE_DIR=/absolute/path/state

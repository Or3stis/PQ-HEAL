# PQ-HEAL Home Hub environment file.
#
# Install to /etc/pq-heal/pq-heal.env with mode 0640, owner root, group pqheal,
# so the service account can read it and other local users cannot.

# Read directly by the server; do not expand this into ExecStart arguments.
# API key required on /ingest and /heartbeat. Generate with:
#   openssl rand -base64 32
PQHEAL_API_KEY=replace-me

# Interface to bind. Set to the data-plane address to keep telemetry ingest off
# the management interface; leave empty to bind all interfaces.
PQHEAL_BIND=

PQHEAL_PORT=9000
